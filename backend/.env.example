# Copy to .env and set your PostgreSQL connection string.
# Local: postgresql://user:password@localhost:5432/meridian
# DigitalOcean: use the connection string from your Managed Database.
DATABASE_URL=postgresql://user:password@localhost:5432/meridian

# Optional: for production (CORS, etc.)
# NODE_ENV=production
# PORT=8080
# FRONTEND_URL=https://your-app.ondigitalocean.app

# Required for real voice notes (Field Notes): Whisper transcription. Without it, voice returns an error.
# OPENAI_API_KEY=sk-...
