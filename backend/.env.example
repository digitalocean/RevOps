# Copy this file to .env and fill in your values

# ─── Database ─────────────────────────────────────────────────
# Local Mac example:
DATABASE_URL=postgresql://your-mac-username@localhost:5432/agileops
# DigitalOcean example (from the database dashboard):
# DATABASE_URL=postgresql://doadmin:YOURPASSWORD@db-agileops-do-user-XXXXX-0.b.db.ondigitalocean.com:25060/defaultdb?sslmode=require
# If you see "self-signed certificate in certificate chain", uncomment:
# NODE_TLS_REJECT_UNAUTHORIZED=0

# ─── Server ────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS (which frontend URL can talk to the backend) ─────────
FRONTEND_URL=http://localhost:5173
