# Copy to .env and set your PostgreSQL connection string.
# Local: postgresql://user:password@localhost:5432/meridian
# DigitalOcean: use the connection string from your Managed Database.
DATABASE_URL=postgresql://user:password@localhost:5432/meridian

# Optional: for production (CORS, etc.)
# NODE_ENV=production
# PORT=8080
# FRONTEND_URL=https://your-app.ondigitalocean.app

# --- Google Sign-In (optional) ---
# Create OAuth 2.0 credentials in Google Cloud Console → APIs & Services → Credentials.
# Authorized redirect URI: https://your-api-url/api/auth/google/callback (or http://localhost:4000/api/auth/google/callback for dev)
# GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxx

# Session secret (required for auth; change in production)
# SESSION_SECRET=your-random-secret-at-least-32-chars

# For production: public URL of this API (used as OAuth callback base). If not set, uses PORT and localhost.
# APP_URL=https://your-api.ondigitalocean.app
# API_BASE_URL=https://your-api.ondigitalocean.app

# --- Voice & AI (optional) ---
# Required for voice transcription (Field Notes): Whisper. Without it, voice transcribe returns an error.
# OPENAI_API_KEY=sk-...

# DigitalOcean Gradient: use for chat completions (e.g. voice → work item). Prefer this over OpenAI for API operations.
# Create key in DO Control Panel → Gradient / AI → Model API Key (starts with do-).
# GRADIENT_MODEL_ACCESS_KEY=do-...
# Optional: chat model override (default: gpt-4o). List models: GET https://inference.do-ai.run/v1/models -H "Authorization: Bearer $GRADIENT_MODEL_ACCESS_KEY"
# GRADIENT_CHAT_MODEL=gpt-4o
