DATABASE_URL=${db.DATABASE_URL}
NODE_ENV=production
PORT=8080
NODE_TLS_REJECT_UNAUTHORIZED=0
SESSION_SECRET=PASTE_LONG_RANDOM_STRING
FRONTEND_URL=https://revops-ntkll.ondigitalocean.app
APP_URL=https://revops-ntkll.ondigitalocean.app
OKTA_ISSUER=PASTE_OKTA_ISSUER
OKTA_CLIENT_ID=PASTE_OKTA_CLIENT_ID
OKTA_CLIENT_SECRET=PASTE_OKTA_CLIENT_SECRET

# --- SAML: IdP metadata URL (from Okta SSO endpoint + /metadata) ---
# Okta: use /app/{instanceId}/sso/saml/metadata (NOT .../app/AppName/instanceId/... — that 404s)
SAML_IDP_METADATA_URL=https://digitalocean.okta.com/app/exk1a2t62juiN4Nmk2p8/sso/saml/metadata
# Must match Okta "Audience URI" exactly (usually same as your app URL, no trailing slash)
SAML_SP_ENTITY_ID=https://revops-ntkll.ondigitalocean.app
# Same https origin as APP_URL (ACS = this + /api/auth/saml/callback)
SAML_APP_BASE_URL=https://revops-ntkll.ondigitalocean.app
