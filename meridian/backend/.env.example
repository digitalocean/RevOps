# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://meridian_user:your_password@localhost:5432/meridian_db

# ── Server ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Frontend URL (for CORS) ───────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── OpenAI (optional — for Voice AI feature) ─────────────
# If not set, voice transcription uses demo mode
OPENAI_API_KEY=sk-...

# ── DigitalOcean App Platform sets DATABASE_URL automatically ──
# No changes needed when deployed to DO App Platform
